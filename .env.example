# Copie para ".env" (ou cadastre estas variáveis no painel Node.js da Hostinger). NUNCA suba o .env para o GitHub.

# --- primeiro administrador (usado só se ainda não existe nenhuma conta; depois APAGUE a senha daqui) ---
ADMIN_USER=direcao
ADMIN_PASSWORD=troque-por-uma-senha-forte-AQUI
ADMIN_NAME=Direção

# --- banco de dados ---
# sqlite (recomendado, não precisa criar nada): um arquivo em data/
DB_DRIVER=sqlite
# DATA_DIR=/caminho/fora/da/pasta/publica   # opcional; padrão: pasta data/ do projeto
# mysql (opcional; exige "npm install" e o banco criado no hPanel):
# DB_DRIVER=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=u123456789_casahiro
# MYSQL_USER=u123456789_casahiro
# MYSQL_PASSWORD=...

# --- leitura de notas por IA (Anthropic) ---
# Chave criada em console.anthropic.com. Fica só aqui, no servidor.
ANTHROPIC_API_KEY=
# IA_POR_MINUTO=20
# IA_POR_DIA=1500
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
# ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5-5
# ANTHROPIC_MODEL_COMPLEX=claude-opus-5-5

# --- segurança ---
# Quem abre por http:// é mandado para https://. Se o site entrar em loop de redirecionamento, use 0.
# FORCAR_HTTPS=1

# --- arquivos e backup ---
# MAX_UPLOAD_MB=25
# MAX_STORAGE_GB=30
# BACKUP_DIAS=14
# Senha para o script tools/puxar-backup.js buscar a cópia fora da Hostinger (use 24+ caracteres aleatórios)
BACKUP_TOKEN=

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirma-destrutivo.js\"",
            "timeout": 10,
            "statusMessage": "Conferindo se o comando é destrutivo"
          }
        ]
      }
    ]
  }
}
